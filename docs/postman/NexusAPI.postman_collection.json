{
  "info": {
    "name": "NexusAPI",
    "description": "Rode 'Criar filme' primeiro: ele salva o _id em {{movieId}}.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000/api"
    },
    {
      "key": "movieId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Teste",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/test",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "test"
          ]
        }
      }
    },
    {
      "name": "Criar filme",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "if (pm.response.code === 201) pm.collectionVariables.set('movieId', pm.response.json()._id);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"Filme Exemplo\",\n  \"kind\": \"Drama\",\n  \"description\": \"Um filme fictício para testar a API.\",\n  \"rating\": 8.5,\n  \"director\": \"Diretora Exemplo\",\n  \"stars\": [\n    \"Ator A\",\n    \"Atriz B\"\n  ],\n  \"poster\": \"https://example.com/poster.jpg\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/movie",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "movie"
          ]
        }
      }
    },
    {
      "name": "Criar filme inválido (422)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"Abc\",\n  \"rating\": 11,\n  \"poster\": \"nao-e-url\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/movie",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "movie"
          ]
        }
      }
    },
    {
      "name": "Listar filmes",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/movie",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "movie"
          ]
        }
      }
    },
    {
      "name": "Buscar filme",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/movie/{{movieId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "movie",
            "{{movieId}}"
          ]
        }
      }
    },
    {
      "name": "Atualizar filme",
      "request": {
        "method": "PATCH",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"rating\": 9\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/movie/{{movieId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "movie",
            "{{movieId}}"
          ]
        }
      }
    },
    {
      "name": "Remover filme",
      "request": {
        "method": "DELETE",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/movie/{{movieId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "movie",
            "{{movieId}}"
          ]
        }
      }
    }
  ]
}
